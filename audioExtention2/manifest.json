{
  "manifest_version": 3,
  "name": "Audio Listener",
  "version": "1.0.0",
  "description": "Detecteerd of een tab audio geeft of niet.",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
